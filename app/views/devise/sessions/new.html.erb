<% content_for :styles do %>
  <style>
    .auth-wrapper {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }
    .auth-card {
      width: 100%;
      max-width: 400px;
      background: var(--dark-card);
      border: 1px solid var(--dark-border);
      border-radius: 16px;
      padding: 2.5rem 2rem;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
    }
    .auth-logo {
      display: block;
      height: 56px;
      width: auto;
      margin: 0 auto 0.5rem;
    }
    .auth-subtitle {
      text-align: center;
      color: var(--dark-text-muted);
      margin-bottom: 2rem;
      font-size: 0.95rem;
    }
    .auth-card .form-label {
      color: var(--dark-text-muted);
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.4rem;
    }
    .auth-card .form-control {
      background: var(--dark-bg);
      border: 1px solid var(--dark-border);
      color: var(--dark-text);
      padding: 0.7rem 0.9rem;
      border-radius: 10px;
    }
    .auth-card .form-control:focus {
      background: var(--dark-bg);
      color: var(--dark-text);
      border-color: #0066ff;
      box-shadow: 0 0 0 0.2rem rgba(0, 102, 255, 0.25);
    }
    .auth-card .form-control::placeholder {
      color: var(--dark-text-muted);
      opacity: 0.6;
    }
    .auth-submit {
      background: #0066ff;
      border: none;
      color: #fff;
      font-weight: 600;
      padding: 0.7rem;
      border-radius: 10px;
      width: 100%;
      transition: background 0.15s ease;
    }
    .auth-submit:hover {
      background: #0052cc;
      color: #fff;
    }
    .auth-links {
      margin-top: 1.5rem;
      text-align: center;
      font-size: 0.9rem;
    }
    .auth-links a {
      color: #0066ff;
      text-decoration: none;
    }
    .auth-links a:hover {
      text-decoration: underline;
    }
    .auth-divider {
      color: var(--dark-border);
      margin: 0 0.5rem;
    }
    .auth-remember {
      color: var(--dark-text-muted);
      font-size: 0.9rem;
    }
    .auth-remember .form-check-input:checked {
      background-color: #0066ff;
      border-color: #0066ff;
    }
  </style>
<% end %>

<div class="auth-wrapper">
  <div class="auth-card">
    <%= image_tag "logo.png", class: "auth-logo", alt: "Kollektor" %>
    <p class="auth-subtitle">Inicia sesión en tu colección</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="mb-3">
        <%= f.label :email, "Correo", class: "form-label" %>
        <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "form-control",
              placeholder: "tucorreo@ejemplo.com" %>
      </div>

      <div class="mb-3">
        <%= f.label :password, "Contraseña", class: "form-label" %>
        <%= f.password_field :password,
              autocomplete: "current-password",
              class: "form-control",
              placeholder: "••••••••" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-3 form-check auth-remember">
          <%= f.check_box :remember_me, class: "form-check-input" %>
          <%= f.label :remember_me, "Mantener sesión iniciada", class: "form-check-label" %>
        </div>
      <% end %>

      <div>
        <%= f.submit "Iniciar sesión", class: "auth-submit" %>
      </div>
    <% end %>

    <div class="auth-links">
      <% if devise_mapping.recoverable? %>
        <%= link_to "¿Olvidaste tu contraseña?", new_password_path(resource_name) %>
      <% end %>
      <% if devise_mapping.registerable? %>
        <span class="auth-divider">·</span>
        <%= link_to "Crear cuenta", new_registration_path(resource_name) %>
      <% end %>
    </div>
  </div>
</div>
