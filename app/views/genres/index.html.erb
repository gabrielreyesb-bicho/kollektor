<div class="container-fluid">
  <!-- Header section with responsive layout -->
  <div class="mb-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between gap-3">
      <h1 class="mb-0">Genres</h1>

      <div class="d-flex gap-2 flex-grow-1 flex-sm-grow-0" style="max-width: 100%;">
        <%= form_tag genres_path, method: :get, class: "flex-grow-1 flex-sm-grow-0", style: "max-width: 300px;" do %>
          <div class="input-group">
            <%= text_field_tag :search, params[:search],
                class: "form-control bg-dark text-white border-secondary",
                placeholder: "Search genres..." %>
            <% if params[:search].present? %>
              <%= link_to genres_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-x-lg"></i>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <%= link_to new_genre_path(collection_type: @collection_type),
            class: "btn btn-primary d-flex align-items-center gap-2",
            style: "white-space: nowrap;" do %>
          <i class="bi bi-plus-lg"></i>
          <span>Add genre</span>
        <% end %>
      </div>
    </div>
  </div>

  <% if @genres.any? %>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
      <% @genres.each do |genre| %>
        <div class="col">
          <div class="card bg-dark border-secondary h-100">
            <% if genre.image.attached? %>
              <%= image_tag genre.image, class: "card-img-top object-fit-cover", style: "height: 160px;" %>
            <% else %>
              <div class="d-flex align-items-center justify-content-center bg-secondary bg-opacity-25" style="height: 160px;">
                <i class="bi bi-music-note-list text-muted" style="font-size: 3rem;"></i>
              </div>
            <% end %>
            <div class="card-body p-2">
              <h6 class="card-title mb-1 text-truncate"><%= genre.name %></h6>
              <small class="text-muted"><%= genre.albums.count %> albums · <%= genre.authors.count %> authors</small>
            </div>
            <div class="card-footer p-1 border-secondary d-flex justify-content-end gap-1">
              <%= link_to edit_genre_path(genre), class: "btn btn-outline-primary btn-sm" do %>
                <i class="bi bi-pencil"></i>
              <% end %>
              <%= link_to genre,
                  class: "btn btn-outline-danger btn-sm",
                  data: { turbo_method: :delete,
                         turbo_confirm: "Are you sure? This will also delete all associated authors and albums." } do %>
                <i class="bi bi-trash"></i>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <div class="display-6 text-muted mb-4">
        <i class="bi bi-music-note-list" style="font-size: 4rem;"></i>
      </div>
      <h3 class="text-muted mb-4">No genres found</h3>
      <%= link_to new_genre_path(collection_type: @collection_type), class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-2"></i>Add your first genre
      <% end %>
    </div>
  <% end %>
</div>
