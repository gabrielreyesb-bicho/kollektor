<%= form_with(model: genre, class: "mb-4") do |form| %>
  <% if genre.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(genre.errors.count, "error") %> prohibited this genre from being saved:</h2>
      <ul>
        <% genre.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row">
    <div class="col-md-8">
      <div class="mb-3">
        <%= form.label :name, class: "form-label" %>
        <%= form.text_field :name, class: "form-control" %>
      </div>

      <div class="mb-3">
        <%= form.label :description, class: "form-label" %>
        <%= form.text_area :description, class: "form-control", rows: 3 %>
      </div>

      <%= form.hidden_field :collection_type_id, value: genre.collection_type_id %>

      <div class="actions">
        <%= form.submit class: "btn btn-primary" %>
        <%= link_to "Cancel", genres_path(collection_type: genre.collection_type&.name), class: "btn btn-light ms-2" %>
      </div>
    </div>

    <div class="col-md-4">
      <div class="mb-4">
        <h5 class="mb-3">Genre Image</h5>
        <%= form.file_field :image,
                          class: "form-control",
                          accept: "image/*",
                          data: {
                            controller: "preview",
                            action: "change->preview#showImage"
                          } %>

        <div class="mt-3">
          <% if form.object.persisted? && form.object.image.attached? %>
            <%= image_tag form.object.image,
                        id: "imagePreview",
                        class: "img-thumbnail",
                        style: "max-height: 200px; width: 100%; object-fit: cover;" %>
          <% else %>
            <img id="imagePreview"
                 class="img-thumbnail"
                 style="max-height: 200px; width: 100%; object-fit: cover; display: none;">
          <% end %>
        </div>
        <small class="text-muted">Upload an image to represent this genre (JPEG/PNG, max 5MB)</small>
      </div>
    </div>
  </div>
<% end %>
