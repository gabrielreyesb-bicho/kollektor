<div class="container-fluid">
  <!-- Header section with responsive layout -->
  <div class="mb-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between gap-3">
      <div class="d-flex align-items-center">
        <h1 class="mb-0">Authors</h1>
        <span class="badge bg-secondary ms-3 fs-6">
          <i class="bi bi-person me-1"></i>
          <%= @authors.count %> authors
        </span>
      </div>

      <div class="d-flex gap-2 flex-grow-1 flex-sm-grow-0 flex-wrap flex-sm-nowrap" style="max-width: 100%;">
        <%= form_tag authors_path, method: :get, class: "d-flex gap-2 flex-grow-1 flex-sm-grow-0 flex-wrap flex-sm-nowrap" do %>
          <%= select_tag :genre_id,
              options_for_select([["All genres", ""]] + @genres.map { |g| [g.name, g.id] }, params[:genre_id]),
              class: "form-select bg-dark text-white border-secondary",
              style: "max-width: 180px;",
              onchange: "this.form.requestSubmit();" %>
          <div class="input-group" style="max-width: 300px;">
            <%= text_field_tag :search, params[:search],
                class: "form-control bg-dark text-white border-secondary",
                placeholder: "Search authors..." %>
            <% if params[:search].present? || params[:genre_id].present? %>
              <%= link_to authors_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-x-lg"></i>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <%= link_to new_author_path,
            class: "btn btn-primary d-flex align-items-center gap-2",
            style: "white-space: nowrap;" do %>
          <i class="bi bi-plus-lg"></i>
          <span>Add author</span>
        <% end %>
      </div>
    </div>
  </div>

  <% if @authors.any? %>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 g-3">
      <% @authors.each do |author| %>
        <div class="col">
          <div class="card bg-dark border-secondary h-100">
            <% if author.image.attached? %>
              <%= image_tag author.image, class: "card-img-top object-fit-cover", style: "height: 160px;" %>
            <% else %>
              <div class="d-flex align-items-center justify-content-center bg-secondary bg-opacity-25" style="height: 160px;">
                <i class="bi bi-person text-muted" style="font-size: 3rem;"></i>
              </div>
            <% end %>
            <div class="card-body p-2">
              <h6 class="card-title mb-1 text-truncate" title="<%= author.name %>"><%= author.name %></h6>
              <small class="text-muted d-block text-truncate" title="<%= [author.genre&.name, author.country&.name].compact.join(' · ') %>">
                <%= author.genre&.name || 'No genre' %> · <%= author.country&.name || 'No country' %>
              </small>
              <small class="text-muted"><%= author.albums.count %> <%= author.albums.count == 1 ? 'album' : 'albums' %></small>
            </div>
            <div class="card-footer p-1 border-secondary d-flex justify-content-end gap-1">
              <%= link_to edit_author_path(author), class: "btn btn-outline-primary btn-sm" do %>
                <i class="bi bi-pencil"></i>
              <% end %>
              <%= link_to author,
                  class: "btn btn-outline-danger btn-sm",
                  data: { turbo_method: :delete,
                         turbo_confirm: "Are you sure? This will also delete all associated albums." } do %>
                <i class="bi bi-trash"></i>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <div class="display-6 text-muted mb-4">
        <i class="bi bi-person" style="font-size: 4rem;"></i>
      </div>
      <h3 class="text-muted mb-4">No authors found</h3>
      <%= link_to new_author_path, class: "btn btn-primary" do %>
        <i class="bi bi-plus-lg me-2"></i>Add your first author
      <% end %>
    </div>
  <% end %>
</div>
