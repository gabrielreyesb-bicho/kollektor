<!DOCTYPE html>
<html>
  <head>
    <title>Kollektor</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
      body {
        background-color: var(--dark-bg);
        color: var(--dark-text);
      }
    </style>
    <%= yield :styles %>
  </head>

  <body>
    <% if notice %>
      <p class="alert alert-success"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="alert alert-danger"><%= alert %></p>
    <% end %>
    
    <% if user_signed_in? %>
      <% if current_page?(root_path) %>
        <!-- Collections Dashboard - No Sidebar -->
        <%= yield %>
      <% elsif mosaic_view? %>
        <!-- Mosaic Views - Full Width Without Sidebar -->
        <div class="main-content-full" data-controller="mosaic-menu">
          <!-- Navbar for mosaic views -->
          <nav class="navbar navbar-dark bg-primary fixed-top mosaic-navbar">
            <div class="container-fluid">
              <div class="d-flex align-items-center">
                <%= image_tag "logo.png", style: "height: 24px; width: auto;" %>
                <span class="ms-2 text-white fw-bold">Kollektor</span>
              </div>
              
              <!-- Menu button -->
              <button class="btn btn-link text-white" 
                      type="button"
                      data-action="click->mosaic-menu#toggle"
                      aria-label="Menu">
                <i class="bi bi-three-dots-vertical" style="font-size: 1.5rem;"></i>
              </button>
            </div>
          </nav>
          
          <!-- Mosaic Menu Overlay -->
          <div class="mosaic-menu-overlay" 
               data-mosaic-menu-target="overlay"
               data-action="click->mosaic-menu#close"
               role="dialog"
               aria-modal="true"
               aria-label="Navigation menu">
            <div class="mosaic-menu-content" 
                 data-action="click->mosaic-menu#stopPropagation"
                 role="document">
              <div class="mosaic-menu-header">
                <h3 class="mb-0">Manage Collections</h3>
                <button class="btn btn-link text-white" 
                        data-action="click->mosaic-menu#close"
                        aria-label="Close menu">
                  <i class="bi bi-x-lg" style="font-size: 1.5rem;"></i>
                </button>
              </div>
              
              <nav class="mosaic-menu-body" aria-label="Main navigation">
                <ul class="nav flex-column gap-2">
                  <li class="nav-item">
                    <%= link_to statistics_path, class: "mosaic-menu-link" do %>
                      <i class="bi bi-graph-up me-3"></i>
                      <span>Statistics</span>
                    <% end %>
                  </li>
                  <li class="nav-item">
                    <a href="#" class="mosaic-menu-link" data-bs-toggle="modal" data-bs-target="#suggestionsModal">
                      <i class="bi bi-lightbulb me-3"></i>
                      <span>Get Suggestions</span>
                    </a>
                  </li>
                  <li class="nav-item">
                    <%= link_to get_lucky_path, class: "mosaic-menu-link" do %>
                      <i class="bi bi-shuffle me-3"></i>
                      <span>Get Lucky</span>
                    <% end %>
                  </li>
                  
                  <li class="mosaic-menu-divider" role="separator"></li>
                  
                  <li class="nav-item">
                    <%= link_to genres_path, class: "mosaic-menu-link" do %>
                      <i class="bi bi-music-note-list me-3"></i>
                      <span>Manage Genres</span>
                    <% end %>
                  </li>
                  <li class="nav-item">
                    <%= link_to authors_path, class: "mosaic-menu-link" do %>
                      <i class="bi bi-person me-3"></i>
                      <span>Manage Authors</span>
                    <% end %>
                  </li>
                  <li class="nav-item">
                    <%= link_to albums_path, class: "mosaic-menu-link" do %>
                      <i class="bi bi-disc me-3"></i>
                      <span>Manage Albums</span>
                    <% end %>
                  </li>
                  <li class="nav-item">
                    <%= link_to countries_path, class: "mosaic-menu-link" do %>
                      <i class="bi bi-globe me-3"></i>
                      <span>Manage Countries</span>
                    <% end %>
                  </li>
                </ul>
              </nav>
            </div>
          </div>
          
          <%= yield %>
        </div>
      <% else %>
        <!-- Collection Pages - With Sidebar -->
        <div class="d-flex min-vh-100" data-controller="sidebar">
          <%= render 'layouts/sidebar' %>

          <!-- Overlay -->
          <div class="sidebar-overlay" 
               data-sidebar-target="overlay" 
               data-action="click->sidebar#toggle"
               role="button"
               tabindex="0"></div>

          <!-- Main Content -->
          <div class="main-content">
            <!-- Navbar -->
            <nav class="navbar navbar-dark bg-primary fixed-top d-md-none">
              <div class="container-fluid d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                  <button class="navbar-toggler border-0 me-2" 
                          type="button" 
                          aria-label="Toggle navigation"
                          data-action="sidebar#toggle">
                    <span class="navbar-toggler-icon"></span>
                  </button>
                  <div class="d-flex align-items-center">
                    <%= image_tag "logo.png", style: "height: 24px; width: auto;" %>
                  </div>
                </div>
                
                <!-- Get Lucky Button in navbar -->
                <% if controller_name == 'music' && action_name == 'index' %>
                  <div class="d-flex align-items-center">
                    <%= link_to get_lucky_path, 
                        class: "btn btn-light btn-sm",
                        style: "border-radius: 20px; font-size: 0.8rem; padding: 0.25rem 0.5rem;" do %>
                      <i class="bi bi-shuffle"></i>
                      <span class="d-none d-sm-inline ms-1">Get Lucky</span>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </nav>

            <!-- Notification Bell Icon (only for series context) -->
            <% if user_signed_in? && !current_page?(root_path) && ['series', 'series_collection', 'actors'].include?(controller_name) %>
              <div class="position-fixed top-0 end-0 p-3" style="z-index: 2000;">
                <div class="dropdown">
                  <a class="btn btn-dark position-relative" href="#" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-bell"></i>
                    <% if @unread_notifications_count.to_i > 0 %>
                      <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                        <%= @unread_notifications_count %>
                      </span>
                    <% end %>
                  </a>
                  <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="notificationDropdown" style="min-width: 300px;">
                    <% if @notifications.present? %>
                      <% @notifications.each do |notification| %>
                        <li class="dropdown-item <%= 'fw-bold' unless notification.read %>">
                          <%= notification.message %>
                          <small class="text-muted d-block"><%= time_ago_in_words(notification.created_at) %> ago</small>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                      <% end %>
                    <% else %>
                      <li class="dropdown-item text-muted">No notifications</li>
                    <% end %>
                  </ul>
                </div>
              </div>
            <% end %>

            <!-- Show due snooze reminders if any -->
            <% if @due_snooze_reminders.present? %>
              <%= render 'shared/due_snooze_reminders', due_snooze_reminders: @due_snooze_reminders %>
            <% end %>



            <%= yield %>
          </div>
        </div>
      <% end %>
    <% else %>
      <%= yield %>
    <% end %>

    <!-- Mood Modal -->
    <% if user_signed_in? && !current_page?(root_path) %>
      <div data-controller="mood-prompt">
        <div class="modal fade" 
             id="suggestionsModal"
             data-mood-prompt-target="modal" 
             tabindex="-1" 
             aria-labelledby="suggestionsModalLabel" 
             aria-hidden="true">
          <div class="modal-dialog modal-lg">
            <div class="modal-content bg-dark text-white">
              <div class="modal-header border-secondary">
                <h5 class="modal-title" id="suggestionsModalLabel">What would you like to listen to?</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <div data-mood-prompt-target="recommendationsContainer"></div>

                <div data-mood-prompt-target="refreshButtonContainer" style="display: none;" class="text-center mt-4">
                  <button class="btn btn-primary" data-action="click->mood-prompt#refreshSuggestions">
                    <i class="bi bi-shuffle me-2"></i>New Suggestions
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </body>
</html>
